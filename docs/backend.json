{
  "entities": {
    "Driver": {
      "title": "Driver",
      "description": "Gas delivery driver or agency profile. Coordinate updates are restricted to 'approved' status and 'available' mode.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "companyLicense": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "availability": { "type": "string", "enum": ["available", "busy"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" },
        "sessionId": { "type": "string", "description": "Unique session ID to enforce single device login." },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "status", "availability", "uid"]
    },
    "Customer": {
      "title": "Customer",
      "description": "General user profile for requesting gas. Access is public and immediate for both creation and updates.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "uid": { "type": "string" },
        "sessionId": { "type": "string", "description": "Unique session ID to enforce single device login." },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "uid"]
    },
    "Request": {
      "title": "Delivery Request",
      "description": "Customer request for gas delivery. Visible to all approved drivers.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "cylinders": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "uid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "phoneNumber", "cylinders", "lat", "lng", "status", "uid"]
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Only approved drivers can broadcast locations."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Open access for all users to register and manage their own profile."
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Active requests for delivery."
    }
  }
}