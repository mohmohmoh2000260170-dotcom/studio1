
{
  "entities": {
    "Driver": {
      "title": "Driver",
      "description": "Information about a gas delivery driver or company. Admin contact: Mohammadalkhalileh296@gmail.com, 0788526771.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The driver's name or company name." },
        "phone": { "type": "string", "description": "Contact phone number." },
        "companyLicense": { "type": "string", "description": "The official business license number." },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Current registration status." },
        "availability": { "type": "string", "enum": ["available", "busy"], "description": "Whether the driver is ready to take orders." },
        "lat": { "type": "number", "description": "Current latitude of the driver." },
        "lng": { "type": "number", "description": "Current longitude of the driver." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the registration was created." },
        "uid": { "type": "string", "description": "The verified Firebase Auth UID." }
      },
      "required": ["name", "phone", "companyLicense", "status", "availability", "lat", "lng", "uid"]
    },
    "Request": {
      "title": "Delivery Request",
      "description": "A customer request for gas cylinder delivery. Includes location and contact details.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "cylinders": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "uid": { "type": "string", "description": "The verified customer UID." }
      },
      "required": ["customerName", "phoneNumber", "cylinders", "lat", "lng", "status", "uid"]
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Collection of driver registrations."
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Collection of active customer delivery requests."
    }
  }
}
